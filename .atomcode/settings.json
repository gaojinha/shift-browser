{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .atomcode/hooks/block-lock-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .atomcode/hooks/format-front.sh"
          }
        ]
      }
    ]
  }
}
