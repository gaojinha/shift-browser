+/// 临时调试：直接追加到 /tmp（CEF 回调线程里的 log 有时进不了 journal）
+fn dl_debug(msg: &str) {
+    use std::io::Write;
+    if let Ok(mut f) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open("/tmp/shift-dl-debug.log")
+    {
+        let _ = writeln!(f, "[{:?}] {msg}", std::time::SystemTime::now());
+    }
+}
