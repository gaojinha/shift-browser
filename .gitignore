src-tauri/resources/libshift_web_extension.so

# 系统
.DS_Store
*.log
*.tmp

# 数据库（运行时生成，位于系统数据目录）
*.db
*.db-wal
*.db-shm
# 本地工具/笔记目录（不入库，2026-09-29 决策）：编辑器配置、纠错笔记等
# 注：.github/ 已于 2026-10-14 解除忽略（CI 护栏卡需入库才生效）
.atomcode/
.learnings/
.trae/
# AtomCode local-scope configs (machine-specific)
.atomcode/local/
# AtomCode 安装状态（机器特定，不入库）
.atomcode/.setup.lock
.atomcode/setup-state.json

# 三方 AI 协作目录：状态/日志/pid/token/缓存一律不入库，
# 但**看板·总线·台账·派单·回执必须可追溯**（否则哨兵核对只能靠文件 mtime，改过无痕）。
# 逐层放行：先忽略 .ai 下各项，再单独重新包含目录与 *.md。
.ai/*
!.ai/WORKBOARD.md
!.ai/MESSAGES.md
!.ai/RECEIPTS.md
!.ai/NOTIFY.md
!.ai/inbox/
!.ai/outbox/
!.ai/evidence/
!.ai/handover/
.ai/inbox/*
.ai/outbox/*
!.ai/inbox/*/
!.ai/outbox/*/
!.ai/**/*.md

# GitHub Copilot CLI 本地设置（机器特定，不入库）
.github/copilot/settings.local.json
.github/copilot/settings.local.json.lock

# 备份与缓存（不入库）
.mcp.json.bak-*
.playwright-mcp/

# 发布物归档（B-06 R4 · 符号/调试文件，不进仓库）
release-artifacts/
e2e/.last-report.json
test-results/
__pycache__/

# 临时截图/取证垃圾（2026-10-27 二狗补：曾被 git add -A 误入账）
tmp/
